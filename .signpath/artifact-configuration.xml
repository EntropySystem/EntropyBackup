<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the Windows build. Paste it into the SignPath project
     (Artifact Configurations). The input is the GitHub artifact "EntropyBackup-windows-x64-unsigned",
     a zip holding both executables; each is Authenticode-signed only if its version info matches. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="EntropyBackup.exe" product-name="Entropy Backup" product-version="1.6.*">
      <authenticode-sign />
    </pe-file>
    <pe-file path="EntropyBackupCLI.exe" product-name="Entropy Backup" product-version="1.6.*">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
